          "name": "Generate a new session",
          "request": {
            "name": "Generate a new session",
            "description": {
              "content": "Generate a short-lived session token used initialize a Slope.js flow on behalf of a customer, skipping the need for the customer to login.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v4",
                "auth",
                "session"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) The access token returned from exchanging the short lived authorizationCode /v4/auth/token endpoint.",
                "key": "Slope-Access-Token",
                "value": "<string>"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{basicAuthUsername}}"
                },
                {
                  "key": "password",
                  "value": "{{basicAuthPassword}}"
                }
              ]
